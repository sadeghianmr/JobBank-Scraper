# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# FastAPI backend used by the Telegram bot.
API_BASE_URL=http://localhost:8000

# Bot-to-API timeout. Larger multi-search scrapes can take several minutes.
API_REQUEST_TIMEOUT_SECONDS=1200

# How often the bot checks whether any user's interval is due.
BOT_SCHEDULER_POLL_SECONDS=900
