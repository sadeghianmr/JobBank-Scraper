<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobbank.scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mrsadeghian/Code/JobBank-Scraper/scripts/run_stack.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mrsadeghian/Code/JobBank-Scraper</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mrsadeghian/Code/JobBank-Scraper/logs/bot/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mrsadeghian/Code/JobBank-Scraper/logs/errors/launchd.err.log</string>
</dict>
</plist>
